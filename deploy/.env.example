ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTERNAL_API_KEY=replace-with-a-long-random-internal-key
WARGAME_VERSION=1.0.0
WARGAME_SOURCE_DIGEST=dev
WARGAME_RELEASE_ID=1.0.0-dev
WARGAME_COMPOSE_PROJECT=wargame
WARGAME_RUNTIME_ENV_FILE=/home/your-user/wargame/.env
# 可选：覆盖 Compose 默认的 wargame-data 卷名，适合隔离测试和灾难恢复演练。
WARGAME_DATA_VOLUME=wargame-data
HOST_BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
HTTP_PORT=8080
WS_PORT=8090
PUBLIC_GAME_WS_URL=ws://localhost:8090
SESSION_HOURS=12
WEB_SHELL_ENABLED=false
WEB_SHELL_TICKET_SECONDS=120
WEB_SHELL_SESSION_SECONDS=900
WEB_SHELL_MAX_SESSIONS=2
WEB_SHELL_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# 只有以下地址直接连接 account-web 时才会信任 X-Forwarded-For。
LOGIN_TRUSTED_PROXIES=
LOGIN_WINDOW_SECONDS=60
LOGIN_SUBJECT_IP_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
ROOM_OPERATION_TIMEOUT_SECONDS=20
WARGAME_ALLOW_RECOVERY_RESET=0
# 单实例游戏服务托管的房间 ID；账号服务和 game-server 必须保持一致。
GAME_ROOM_ID=main
# PVE AI provider: rules（仅规则）、auto（Ollama 不可用时回退规则）或 ollama。
AI_PROVIDER=auto
# Compose 容器通过 host gateway 访问宿主机；原生 game-server 请改为
# http://127.0.0.1:11434（见 docs/ONLINE_DEPLOYMENT.md）。
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=auto
OLLAMA_CONNECT_TIMEOUT_MS=1500
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RESPONSE_BYTES=65536
# Fast DDS is disabled until authenticated encrypted transport is deployed.
# WebSocket remains the only authoritative data path.
WARGAME_ENABLE_FASTDDS=OFF
WARGAME_FASTDDS_MODE=disabled
FASTDDS_DOMAIN_ID=0
FASTDDS_DISCOVERY_TIMEOUT_MS=5000
FASTDDS_STATIC_PEERS=
